<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>conduit</AssemblyName>
        <RuntimeIdentifiers>win-x64;linux-x64;linux-musl-x64</RuntimeIdentifiers>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <RootNamespace>Conduit</RootNamespace>
        <IsPackable>false</IsPackable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <DefineConstants>$(DefineConstants);CONDUIT_WINDOWS</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
        <DefineConstants>$(DefineConstants);CONDUIT_LINUX</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</RuntimeIdentifier>
        <PublishDir>$(MSBuildProjectDirectory)/publish/$(RuntimeIdentifier)/</PublishDir>

        <PublishTrimmed>false</PublishTrimmed>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <InvariantGlobalization>true</InvariantGlobalization>
        <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
        <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'linux-musl-x64' ">
        <DefineConstants>$(DefineConstants);CONDUIT_LINUX_MUSL</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\Conduit.Unity\Core\BridgeContract.cs" Link="Bridge\BridgeContract.cs"/>
        <Compile Include="..\Conduit.Unity\Core\BridgeExceptionFormatter.cs" Link="Bridge\BridgeExceptionFormatter.cs"/>
        <Compile Include="..\Conduit.Unity\Core\BridgeStringBuilderPool.cs" Link="Bridge\BridgeStringBuilderPool.cs"/>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0"/>
        <PackageReference Include="ModelContextProtocol" Version="1.1.0"/>
        <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.1.0"/>
        <PackageReference Include="System.CommandLine" Version="2.0.5"/>
        <PackageReference Include="ZLinq" Version="1.5.5"/>
        <PackageReference Include="ZLogger" Version="2.5.10"/>
        <PackageReference Include="ZString" Version="2.6.0"/>
    </ItemGroup>

</Project>
